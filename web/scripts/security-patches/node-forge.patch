+/**
+ * Canonically DER-encodes a DigestInfo for a given digest algorithm OID and
+ * raw digest value.
+ *
+ * This is used by RSASSA-PKCS1-v1_5 signature verification to detect any
+ * non-canonical encoding of the DigestInfo structure. forge's BER parser and
+ * asn1.validate() are intentionally lenient: they silently ignore extra
+ * elements in a SEQUENCE, accept a NULL that carries content bytes, and accept
+ * non-minimal (long form) length octets. Each of those gives an attacker
+ * "slack" bytes inside a structurally valid DigestInfo, which is exactly what
+ * is needed to mount a Bleichenbacher-style signature forgery against keys
+ * with a low public exponent (e.g. e=3). Re-encoding the expected DigestInfo
+ * and comparing bytes rejects all such slack in one check rather than
+ * enumerating individual malformed shapes.
+ *
+ * @param oid the digest algorithm OID as a dotted string.
+ * @param digestBytes the raw digest value as a binary-encoded string.
+ * @param withParams true to include the NULL parameters field in the
+ *          DigestAlgorithmIdentifier, false to omit it. Both forms occur in
+ *          practice (the with-parameters form is produced by forge and
+ *          OpenSSL), so callers compare against both.
+ *
+ * @return the DER-encoded DigestInfo as a binary-encoded string.
+ */
+var _encodeDigestInfo = function(oid, digestBytes, withParams) {
+  var algorithmIdentifier = [asn1.create(
+    asn1.Class.UNIVERSAL, asn1.Type.OID, false,
+    asn1.oidToDer(oid).getBytes())];
+  if(withParams) {
+    algorithmIdentifier.push(asn1.create(
+      asn1.Class.UNIVERSAL, asn1.Type.NULL, false, ''));
+  }
+  var digestInfo = asn1.create(
+    asn1.Class.UNIVERSAL, asn1.Type.SEQUENCE, true, [
+      asn1.create(
+        asn1.Class.UNIVERSAL, asn1.Type.SEQUENCE, true, algorithmIdentifier),
+      asn1.create(
+        asn1.Class.UNIVERSAL, asn1.Type.OCTETSTRING, false, digestBytes)
+    ]);
+  return asn1.toDer(digestInfo).getBytes();
+};
