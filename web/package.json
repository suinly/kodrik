    "rehype-sanitize": "^6.0.0",
    "uqr": "0.1.3",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3",
    "vue-tsc": "^3.1.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
