{
  "name": "kodrik-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "ui:catalog": "node scripts/generate-ui-catalog.mjs",
